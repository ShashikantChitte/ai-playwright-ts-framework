# ---- Target environment ----
TEST_ENV=prod                       # dev | qa | prod (selects defaults in src/config/env.ts)
BASE_URL=https://shop.qaautomationlabs.com
API_BASE_URL=https://testing.qaautomationlabs.com/api/v1

# ---- Credentials (NEVER commit real secrets; use Azure DevOps variable groups / Key Vault) ----
SHOP_USER_EMAIL=demo@demo.com
SHOP_USER_PASSWORD=demo
API_USER_EMAIL=qa@demo.io
API_USER_PASSWORD=Password123

# ---- Execution ----
CI=false
WORKERS=                            # blank = Playwright default (50% of cores locally, 2 on CI)
RETRIES=
HEADLESS=true
TRACE=on-first-retry                # on | off | retain-on-failure | on-first-retry
RUN_QUARANTINE=false

# ---- Optional extra HTTP headers (e.g. to pass a WAF/bot-protection allow-list token) ----
# EXTRA_HTTP_HEADERS={"x-qa-token":"<token-agreed-with-site-owner>"}

# ---- Self-healing ----
HEALING_ENABLED=true
HEALING_GRACE_MS=1500               # how long the primary locator gets before fallbacks are considered
HEALING_TIMEOUT_MS=5000             # total budget to find an element before failing

# ---- AI (optional; everything degrades gracefully without it) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
